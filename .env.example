# Database URL for PostgreSQL / Supabase Supavisor Pooler (Prisma ORM)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?schema=public"

# Supabase Public URL & Publishable Key
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Secret Key for Session Signing (Generate with: openssl rand -hex 32)
AUTH_SECRET="replace-with-32-byte-hex-secret"

# Optional Secret Key for QRIS Payment Webhook Signature Validation
PAYMENT_GATEWAY_SERVER_KEY="development-secret-key"
